{
  "schema": "schema.graphql",
  "documents": "src/**/queries.ts",
  "generates": {
    "src/app/__generated__/types.ts": {
      "plugins": ["typescript", "typescript-operations"],
      "config": {
        "useTypeImports": true,
        "enumsAsTypes": true,
        "scalars": {
          "DateTime": "string",
          "Date": "string",
          "Time": "string",
          "JSON": "Record<string, any>",
          "Upload": "File"
        }
      }
    }
  },
  "hooks": {}
}
